i></ol></pre><pre id=3D"for_copy1" class=3D"source-code-for-copy">from coll=
ections import deque
import random

random.seed(0)

DX =3D [-1, 1, 0, 0]
DY =3D [0, 0, -1, 1]

def read_initial_input():
    N, M, T, U =3D map(int, input().split())
    V =3D [list(map(int, input().split())) for _ in range(N)]
    sx, sy =3D [0] * M, [0] * M
    for p in range(M):
        sx[p], sy[p] =3D map(int, input().split())

    owner =3D [[-1] * N for _ in range(N)]
    level =3D [[0] * N for _ in range(N)]
    px, py =3D list(sx), list(sy)
    for p in range(M):
        owner[sx[p]][sy[p]] =3D p
        level[sx[p]][sy[p]] =3D 1

    return N, M, T, U, V, owner, level, px, py

def get_candidates(N, M, owner, px, py):
    reachable =3D {(px[0], py[0])}
    queue =3D deque([(px[0], py[0])])
    while queue:
        x, y =3D queue.popleft()
        for d in range(4):
            nx, ny =3D x + DX[d], y + DY[d]
            if 0 &lt;=3D nx &lt; N and 0 &lt;=3D ny &lt; N and (nx, ny) not=
 in reachable and owner[nx][ny] =3D=3D 0:
                reachable.add((nx, ny))
                queue.append((nx, ny))

    candidates =3D set(reachable)
    for x, y in reachable:
        for d in range(4):
            nx, ny =3D x + DX[d], y + DY[d]
            if 0 &lt;=3D nx &lt; N and 0 &lt;=3D ny &lt; N:
                candidates.add((nx, ny))

    for p in range(1, M):
        candidates.discard((px[p], py[p]))

    return candidates

def read_turn_result(N, M, owner, level, px, py):
    for _ in range(M):
        tx, ty =3D map(int, input().split())
    for p in range(M):
        px[p], py[p] =3D map(int, input().split())
    for i in range(N):
        row =3D list(map(int, input().split()))
        for j in range(N):
            owner[i][j] =3D row[j]
    for i in range(N):
        row =3D list(map(int, input().split()))
        for j in range(N):
            level[i][j] =3D row[j]

def main():
    N, M, T, U, V, owner, level, px, py =3D read_initial_input()

    for _ in range(T):
        candidates =3D get_candidates(N, M, owner, px, py)
        tx, ty =3D random.choice(list(candidates))
        print(tx, ty, flush=3DTrue)
        read_turn_result(N, M, owner, level, px, py)

if __name__ =3D=3D '__main__':
    main()
