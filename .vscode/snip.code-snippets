      "            static_assert(std::is_convertible_v<decltype(e), std::function<S()>>,",
      "                          \"e must work as S()\");",
      "            static_assert(std::is_convertible_v<decltype(inv), std::function<S(S)>>,",
      "                          \"inv must work as S(S)\");",
      "        ",
      "            vector<int> dat;",
      "            vector<S> pot;",
      "        ",
      "            UnionFindWithPotential(int N) : dat(N, -1), pot(N, e()) {}",
      "        ",
      "            int root(int x) {",
      "                if (dat[x] < 0) return x;",
